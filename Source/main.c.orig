  1.左边main.c那个加号不用点开,这是一个程序模板,有调用的部分看这个main.c;

  2.请查看视频:链接：https://share.weiyun.com/fLbUW4rH,这些keil基本操作一定要学,
   有助于你更快掌握代码;

  3.因部分电脑配置不同,部分代码会显示红线,只要编译了,0个error就行了(有警告不管,不会影响运行,keil语法严格规定,
    机器又傻瓜式,不会去判断其实语法也可以那样写,自然给你警告);

  4.代码看懂方法,就是从下面的main(void)函数里面一行行的看,如果遇到不懂,复制去字典搜索,你可以上面第二点介绍
     方法去查看函数的具体代码,这些都是底层驱动,你如果没有基础或者熟读芯片手册,你是看不懂,我也不解释,老师有
     问,你就说买芯片厂家送的驱动代码或网上下,老师也都这鸟样;

     代码字典,打开这个链接：
     https://share.weiyun.com/tQL3ergu
     里面有教你C语言常用的语法,最主要就是那个代码字典,
     你如果代码不懂,就把代码扔到字典里面搜索,几乎涵盖大部分
*/
#include "stm32f10x_lib.h"
#include "platform_config.h"
#include "include.h"
#include "header.h"
extern void uart_xuni(void);
vu8 cn1 = 0;                  // 定义计时变量
void TIM1_UP_IRQHandler(void) // 定时器是100us
{

    if (TIM == TIM1)
    {
        if (TIM_GetITStatus(TIM, TIM_IT_Update) != RESET) // 判断是否为 更新事件 标志位
        {
            TIM_ClearITPendingBit(TIM, TIM_IT_Update); // 清除 	更新事件 标志
						uart_xuni();//虚拟串口
            cn1++;                                     // 变量+1
            if (cn1 > 9)                               // 100us*10=1ms
            {
                cn1 = 0;       // 清零变量
                uartinitirq(); // 负责接收串口
            }
        }
    }
}

int main(void)
{
    vu16 i, j = 0, k = 0, flag = 0; // jdq
    RCC_Configuration();            // 时钟初始化
    NVIC_Configuration();           // 中断初始化 sendchar
    delay_init(72);                 // 延时初始化
    delay_ms(300);                  // 延时300ms,因为要禁用jtag口
    SysRead();
    UARTT_Init(USART1); // 串口初始化

    Tim1_Init(1); // 定时器初始化

    GPIOO_Init(); // IO口初始化
    UART4_INIT();
    set(PA, 5, out);
    set(PA, 11, od);    // 设备IO口初始化
    UARTT_Init(USART2); // 串口初始化

#if 1//串口4,如果5写5,支持2个串口,因为有外部中断,十次都很准
	
    UART4_INIT();//定时1默认还是100us,有用到外部中断才104us(100us不行)
		sendstr(4,"152");
		if(Uart_RecOk4)
		{
				Uart_RecOk4=0;
				LCD_DisStr(0,0,Uart_Rx4);//显示收到的数据
				RecCnt4=0;//清零字节计数,不能定时器
		}
#endif
    // UARTT_Init(USART3); //C6T6没串口3,	Tx引脚,1602_D3脚,Rx=D4脚,必须放while前面
    while (1)
    {

        k++;
        if (k > 12)
        {
            k = 0;
            wifi_start(uartwifi);
            wifi_sendnum(uartwifi, TempNow);
            wifi_sendnum(uartwifi, PAin(0));
            //	wifi_sendstr(uartwifi,&weidu[0]);
            //	wifi_sendstr(uartwifi,&jingdu[0]);
            wifi_end(uartwifi);
        }
        delayms(100);
    }
}
